{
    "name": "sayedsahin/bhitti",
    "description": "A lightweight, high-performance PHP framework.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../bhitti-framework",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/common.php"
        ]
    },
    "require": {
        "php": ">=8.3",
        "sayedsahin/bhitti-framework": "dev-main"
    }
}
