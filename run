#!/usr/bin/env php
<?php

declare(strict_types=1);

use Bhitti\Console\Application;
use Bhitti\Console\CommandRegistry;
use Bhitti\Core\Container;

if (PHP_SAPI !== 'cli') {
    http_response_code(403);
    exit('This command can only be run from the CLI.');
}

$debug = false;
$exitCode = 1;

try {
    $app = require __DIR__ . '/bootstrap/app.php';
    $app->boot();

    $debug = (bool) config('app.debug', false);

    if (!isset($container) || !$container instanceof Container) {
        throw new RuntimeException(
            'The application container is not available after bootstrap.'
        );
    }

    $registry = new CommandRegistry();

    $frameworkCommandFile = ROOT_PATH
        . '/src/Bhitti/Console/commands.php';

    $appCommandFile = ROOT_PATH . '/config/commands.php';

    if (!is_file($frameworkCommandFile)) {
        throw new RuntimeException(
            "Framework command file not found: {$frameworkCommandFile}"
        );
    }

    $frameworkCommands = require $frameworkCommandFile;

    if (!is_array($frameworkCommands)) {
        throw new RuntimeException(
            "Framework command file must return an array: {$frameworkCommandFile}"
        );
    }

    $applicationCommandFile = ROOT_PATH . '/config/commands.php';

    $applicationCommands = is_file($applicationCommandFile)
        ? require $applicationCommandFile
        : [];

    $registry->addMany($frameworkCommands);
    $registry->addMany($applicationCommands);

    $console = new Application(
        $container,
        $registry,
        $debug
    );

    $exitCode = $console->run(
        $_SERVER['argv'] ?? []
    );
} catch (Throwable $exception) {
    fwrite(
        STDERR,
        'Console failed: '
        . $exception->getMessage()
        . PHP_EOL
    );

    if ($debug) {
        fwrite(
            STDERR,
            $exception->getTraceAsString()
            . PHP_EOL
        );
    }
}

exit($exitCode);